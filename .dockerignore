# Keep the image code-only. CLIENT DATA MUST NEVER ENTER A BUILD CONTEXT
# (same policy as .gitignore — data moves via sync or export, never baked
# into images).

.git
venv
__pycache__
**/__pycache__
*.pyc

# runtime state (mounted as a volume, never baked in)
data
uploads
capactive_config.db
capactive_sync.ini

# client source data
portfolio_ownership
portfolio_cashflow_db
lease_abstraction_db
disposition_diligence_db
Ownership Deliverables

# bespoke client engines / reference material (deal modules degrade to
# neutral example defaults without them; see modules/deal_seed.py)
proforma_engine
reference_data
properties.json
_compare_scorecard
*.docx
*.xlsx
cre_fundamentals.html
git_push.sh

# large local artifacts
*.zip
*.db
*.duckdb
*.msg
*.log

# dev/test detritus
.vscode
.idea
TESTING_CHECKLIST.md
