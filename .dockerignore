# Keep the image code-only. CLIENT DATA MUST NEVER ENTER A BUILD CONTEXT
# (same policy as .gitignore — data moves via sync or export, never baked
# into images).

.git
venv
__pycache__
**/__pycache__
*.pyc

# runtime state (mounted as a volume, never baked in)
data
uploads
capactive_config.db
capactive_sync.ini

# client source data
portfolio_ownership
Ownership Deliverables

# bespoke client engines live outside this repo (modules/bespoke_engines.py);
# deal modules degrade to neutral example defaults without them
bespoke_engines.json
reference_data
properties.json
_compare_scorecard
*.docx
*.xlsx
cre_fundamentals.html
scripts

# large local artifacts
*.zip
*.db
*.duckdb
*.msg
*.log

# dev/test detritus
.vscode
.idea
CLAUDE.md
.claude
