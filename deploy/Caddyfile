# TLS termination for a Capactive org instance (docs/DEPLOY.md).
# Caddy provisions and renews Let's Encrypt certificates automatically —
# the only requirement is that CAPACTIVE_DOMAIN's DNS points at this host
# and ports 80/443 are reachable.

{$CAPACTIVE_DOMAIN} {
    reverse_proxy app:5000

    # sync pushes carry whole source PDFs
    request_body {
        max_size 512MB
    }

    encode gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
